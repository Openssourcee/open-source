{
  "name": "open-source-os",
  "main": "worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./sitio",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "os-contributions",
      "database_id": "5b7c35d6-0b79-4de0-bfe5-26b6e1f977ba"
    }
  ],
  "observability": { "enabled": true }
}
